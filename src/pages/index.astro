---
import '../styles/global.css';

const year = new Date().getFullYear();

const features = [
  {
    title: 'سهل الاستخدام',
    text: 'بدون أي خبرة تقنية، تبدأ في دقائق.',
    icon: '/img/icon-hand.jpg',
  },
  {
    title: 'تخصيص كامل',
    text: 'صمّم متجرك بالطريقة التي تحبها.',
    icon: '/img/icon-palette.jpg',
  },
  {
    title: 'طرق دفع متعددة',
    text: 'كاش، ماكينة POS، فودافون كاش، إنستاباي.',
    icon: '/img/icon-card.jpg',
  },
  {
    title: 'إدارة شحن مرنة',
    text: 'حدّد المناطق والأسعار بنفسك.',
    icon: '/img/icon-truck.jpg',
  },
  {
    title: 'دعم فني مميز',
    text: 'مساعدتك دائمًا، من أول طلب.',
    icon: '/img/icon-headset.jpg',
  },
];

const steps = [
  {
    title: 'سجّل في المنصة',
    text: 'أنشئ حسابك في دقائق وابدأ رحلتك.',
  },
  {
    title: 'خصّص متجرك',
    text: 'أضف منتجاتك، ووثّق شكل متجرك بكل سهولة.',
  },
  {
    title: 'ابدأ البيع',
    text: 'اعرض متجرك على رابط خاص واستقبل طلباتك.',
  },
];

// شهادات مؤقتة (Sample) — تُستبدل بشهادات عملاء حقيقيين قبل الإطلاق.
const quotes = [
  {
    text: 'أفضل منصة لإنشاء متجر احترافي بدون أي تعقيد، وكل حاجة واضحة من أول يوم.',
    name: 'محمد علي',
    role: 'صاحب متجر مستلزمات منزلية',
    initial: 'م',
  },
  {
    text: 'الدعم الفني ممتاز والتجربة سلسة من البداية حتى الآن، وردّوا عليّا في نفس اليوم.',
    name: 'سارة محمد',
    role: 'صاحبة متجر ملابس',
    initial: 'س',
  },
  {
    text: 'منصة رائعة وسهلة التعامل، ساعدتني في زيادة مبيعاتي بشكل كبير.',
    name: 'أحمد محمود',
    role: 'صاحب متجر إلكترونيات',
    initial: 'أ',
  },
];
---

<!doctype html>
<html lang="ar" dir="rtl">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Klyvin — متجرك الإلكتروني يبدأ من هنا</title>
    <meta
      name="description"
      content="منصة بتخليك تفتح متجر إلكتروني كامل من غير برمجة: منتجات، طلبات، دفع وشحن، ولوحة تحكم تدير منها كل حاجة."
    />
    <link rel="icon" type="image/png" href="/brand/icon.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;500;600;700;800;900&family=Alexandria:wght@500;600;700;800&display=swap"
      rel="stylesheet"
    />
  </head>

  <body>
    <header class="site-header">
      <div class="shell header-inner">
        <a class="brand" href="/" aria-label="Klyvin — الصفحة الرئيسية">
          <img src="/brand/wordmark.png" alt="Klyvin" width="600" height="399" />
        </a>

        <nav class="nav" aria-label="روابط الموقع">
          <a href="#features">المميزات</a>
          <a href="#steps">كيف تبدأ</a>
          <a href="#products">أنواع المنتجات</a>
          <a href="#payments">الدفع والشحن</a>
        </nav>

        <div class="header-actions">
          <a class="signin" href="#start">
            <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M19 21v-1.5a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4V21" /><circle cx="12" cy="7.5" r="3.5" /></svg>
            تسجيل الدخول
          </a>
          <a class="btn btn--orange btn--sm" href="#start">
            ابدأ مجانًا
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M19 12H5" /><path d="m11 18-6-6 6-6" /></svg>
          </a>
        </div>
      </div>
    </header>

    <main>
      <!-- ══ الهيرو ══ -->
      <section class="hero">
        <div class="shell hero-grid">
          <div class="hero-copy">
            <h1>
              متجرك الإلكتروني<br />
              <span class="mark">
                يبدأ من هنا
                <svg viewBox="0 0 240 16" preserveAspectRatio="none" aria-hidden="true">
                  <path d="M4 11C56 4 150 2 236 8" fill="none" stroke="currentColor" stroke-width="7" stroke-linecap="round"></path>
                </svg>
              </span>
            </h1>

            <p class="lede">
              أنشئ متجرك، اعرض منتجاتك، واستقبل طلباتك،<br class="br-desk" />
              كل ده من مكان واحد، من غير برمجة.
            </p>

            <div class="hero-cta">
              <a class="btn btn--orange" href="#start">
                ابدأ مجانًا
                <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M19 12H5" /><path d="m11 18-6-6 6-6" /></svg>
              </a>
              <a class="btn btn--ghost" href="#steps">
                <span class="play" aria-hidden="true">
                  <svg width="9" height="11" viewBox="0 0 10 12" fill="currentColor"><path d="M9 5.13a1 1 0 0 1 0 1.74L1.5 11.3A1 1 0 0 1 0 10.43V1.57A1 1 0 0 1 1.5.7L9 5.13Z" /></svg>
                </span>
                شاهد شرح المنصة
              </a>
            </div>

            <ul class="trust">
              <li>
                <span class="tick" aria-hidden="true"><svg width="9" height="9" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3.4" stroke-linecap="round" stroke-linejoin="round"><path d="m4 12.5 5 5 11-11" /></svg></span>
                مجاني للبدء
              </li>
              <li>
                <span class="tick" aria-hidden="true"><svg width="9" height="9" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3.4" stroke-linecap="round" stroke-linejoin="round"><path d="m4 12.5 5 5 11-11" /></svg></span>
                دعم فني مميز
              </li>
              <li>
                <span class="tick" aria-hidden="true"><svg width="9" height="9" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3.4" stroke-linecap="round" stroke-linejoin="round"><path d="m4 12.5 5 5 11-11" /></svg></span>
                متوافق مع الجوال
              </li>
            </ul>
          </div>

          <div class="hero-art">
            <span class="hero-glow" aria-hidden="true"></span>
            <svg class="heart" viewBox="0 0 100 92" aria-hidden="true">
              <path
                d="M50 88C8 60 2 39 2 26 2 12 13 2 26 2c9 0 18 5 24 13 6-8 15-13 24-13 13 0 24 10 24 24 0 13-6 34-48 62Z"
                fill="#FF8A3D"
                opacity="0.92"></path>
            </svg>

            <img
              class="mascot"
              src="/brand/mascot-cut.png"
              alt="شخصية Klyvin"
              width="464"
              height="692"
              fetchpriority="high"
            />

            <div class="laptop" aria-hidden="true">
              <div class="laptop-lid">
                <div class="screen">
                  <div class="s-top">
                    <span class="s-dots"><i></i><i></i><i></i></span>
                    <span class="s-search">ابحث عن منتج…</span>
                    <span class="s-cart"></span>
                  </div>

                  <div class="s-banner">
                    <div class="s-banner-copy">
                      <strong>كل اللي تحتاجه<br />بجودة عالية وأفضل سعر</strong>
                      <span class="s-btn">تسوّق الآن</span>
                    </div>
                    <img src="/img/icon-headset.jpg" alt="" width="1024" height="1024" />
                  </div>

                  <div class="s-grid">
                    <div class="s-card"><span class="s-thumb"></span><span class="s-line"></span><span class="s-price">٢٤٩ ج</span></div>
                    <div class="s-card"><span class="s-thumb s-thumb--2"></span><span class="s-line"></span><span class="s-price">٣٩٠ ج</span></div>
                    <div class="s-card"><span class="s-thumb s-thumb--3"></span><span class="s-line"></span><span class="s-price">٧٥٠ ج</span></div>
                  </div>
                </div>
              </div>
              <div class="laptop-base"></div>
            </div>
          </div>
        </div>
      </section>

      <!-- ══ المميزات ══ -->
      <section class="section" id="features">
        <div class="shell">
          <div class="section-head">
            <span class="pill">لماذا Klyvin؟</span>
            <h2>كل اللي تحتاجه في منصة واحدة</h2>
          </div>

          <ul class="features">
            {
              features.map((feature) => (
                <li class="feature">
                  <img src={feature.icon} alt="" width="1024" height="1024" loading="lazy" />
                  <h3>{feature.title}</h3>
                  <p>{feature.text}</p>
                </li>
              ))
            }
          </ul>
        </div>
      </section>

      <!-- ══ كيف تبدأ ══ -->
      <section class="section section--paper" id="steps">
        <div class="shell steps-wrap">
          <div class="steps-copy">
            <div class="section-head section-head--start">
              <span class="pill">كيف تبدأ؟</span>
              <h2>3 خطوات بسيطة لامتلاك متجرك</h2>
            </div>

            <ol class="steps">
              {
                steps.map((step, index) => (
                  <li class="step">
                    <span class="num" aria-hidden="true">{index + 1}</span>
                    <h3>{step.title}</h3>
                    <p>{step.text}</p>
                  </li>
                ))
              }
            </ol>
          </div>

          <div class="steps-art" aria-hidden="true">
            <span class="art-tag">لوحة تحكم سهلة وبسيطة</span>

            <div class="mock-dash">
              <div class="mock-dash-bar"><i></i><i></i><i></i></div>
              <div class="mock-dash-body">
                <aside class="mock-dash-side">
                  <span class="mock-dash-logo">k</span>
                  <span class="mock-di"></span>
                  <span class="mock-di"></span>
                  <span class="mock-di"></span>
                  <span class="mock-di"></span>
                </aside>
                <div class="mock-dash-main">
                  <div class="mock-dash-cards">
                    <div class="mock-dcard">
                      <span class="dl">إجمالي المبيعات</span>
                      <strong>1,248</strong>
                      <span class="up">↑ 12.5%</span>
                    </div>
                    <div class="mock-dcard">
                      <span class="dl">إجمالي الطلبات</span>
                      <strong>320</strong>
                      <span class="up">↑ 8.1%</span>
                    </div>
                  </div>
                  <svg class="mock-chart" viewBox="0 0 300 96" preserveAspectRatio="none">
                    <defs>
                      <linearGradient id="chartFill" x1="0" y1="0" x2="0" y2="1">
                        <stop offset="0" stop-color="#FF8A3D" stop-opacity=".45"></stop>
                        <stop offset="1" stop-color="#FF8A3D" stop-opacity="0"></stop>
                      </linearGradient>
                    </defs>
                    <path
                      d="M0 74 40 64 80 70 120 46 160 54 200 32 240 40 300 12 300 96 0 96Z"
                      fill="url(#chartFill)"></path>
                    <path
                      d="M0 74 40 64 80 70 120 46 160 54 200 32 240 40 300 12"
                      fill="none"
                      stroke="#FF8A3D"
                      stroke-width="3"
                      stroke-linecap="round"
                      stroke-linejoin="round"></path>
                  </svg>
                </div>
              </div>
            </div>

            <svg class="mock-dash-arrow" viewBox="0 0 70 48" fill="none" aria-hidden="true">
              <path d="M64 6C44 2 18 8 10 30" stroke="#FF8A3D" stroke-width="4" stroke-linecap="round"></path>
              <path d="M10 30l-1-12M10 30l11-5" stroke="#FF8A3D" stroke-width="4" stroke-linecap="round"></path>
            </svg>
          </div>
        </div>
      </section>

      <!-- ══ أنواع المنتجات ══ -->
      <section class="section" id="products">
        <div class="shell">
          <div class="products-band">
            <div class="band-head">
              <h2>كل هذا وأكثر…</h2>
              <p>في منصة واحدة مصممة لنجاح متجرك.</p>
            </div>

            <article class="p-card">
              <img class="blend" src="/img/products-physical.jpg" alt="" width="1184" height="880" loading="lazy" />
              <div class="p-copy">
                <h3><span class="spark" aria-hidden="true">✦</span> منتجات مادية</h3>
                <p>ملابس، إلكترونيات، وأكثر — مع شحن.</p>
              </div>
            </article>

            <article class="p-card">
              <img class="blend" src="/img/products-digital.jpg" alt="" width="1184" height="880" loading="lazy" />
              <div class="p-copy">
                <h3><span class="spark" aria-hidden="true">✦</span> منتجات رقمية</h3>
                <p>كورسات، كتب إلكترونية، ومستندات — تفعيل فوري بعد الدفع.</p>
              </div>
            </article>
          </div>
        </div>
      </section>

      <!-- ══ الدفع والشحن ══ -->
      <section class="section section--tight" id="payments">
        <div class="shell">
          <div class="section-head">
            <span class="pill">الدفع والشحن</span>
            <h2>الدفع زي ما زباينك بيحبوا</h2>
          </div>

          <div class="payments">
            <ul class="pay-chips">
              <li class="pay-chip">كاش عند الاستلام</li>
              <li class="pay-chip">ماكينة POS</li>
              <li class="pay-chip">فودافون كاش</li>
              <li class="pay-chip">إنستاباي</li>
            </ul>
            <p>
              الزبون بيختار الطريقة اللي تريحه، وكل منطقة عندها سعر شحنها لوحده.
            </p>
          </div>
        </div>
      </section>

      <!-- ══ آراء التجار ══ -->
      <section class="section section--paper" id="reviews">
        <div class="shell">
          <div class="section-head">
            <span class="pill">ماذا يقول عملاؤنا؟</span>
            <h2>آلاف التجار يثقون في Klyvin</h2>
          </div>

          <ul class="quotes">
            {
              quotes.map((quote) => (
                <li class="quote">
                  <span class="qmark" aria-hidden="true">”</span>
                  <p>{quote.text}</p>
                  <div class="who">
                    <span class="avatar" aria-hidden="true">{quote.initial}</span>
                    <span class="who-copy">
                      <strong>{quote.name}</strong>
                      <span>{quote.role}</span>
                    </span>
                  </div>
                </li>
              ))
            }
          </ul>
        </div>
      </section>

      <!-- ══ بانر الدعوة ══ -->
      <section class="cta-band" id="start">
        <div class="shell">
          <div class="cta-panel">
            <svg class="plane" viewBox="0 0 120 70" fill="none" aria-hidden="true">
              <path d="M8 44c18-16 40-22 62-16" stroke="#FF8A3D" stroke-width="3" stroke-linecap="round" stroke-dasharray="2 9"></path>
              <path d="M78 12l30 16-30 16 5-16-5-16Z" stroke="#FF8A3D" stroke-width="3.4" stroke-linejoin="round"></path>
              <path d="M108 28 83 28" stroke="#FF8A3D" stroke-width="3.4" stroke-linecap="round"></path>
            </svg>

            <div class="cta-copy">
              <h2>جاهز تبدأ رحلتك في عالم التجارة الإلكترونية؟</h2>
              <p>إنشاء متجرك الآن مجانًا واستمتع بكل المميزات.</p>
            </div>

            <a class="btn btn--orange" href="#start">
              ابدأ مجانًا
              <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M19 12H5" /><path d="m11 18-6-6 6-6" /></svg>
            </a>

            <img class="cta-mascot" src="/brand/mascot-cut.png" alt="" width="464" height="692" loading="lazy" />
          </div>
        </div>
      </section>
    </main>

    <footer class="site-footer">
      <div class="shell footer-inner">
        <a class="foot-brand" href="/" aria-label="Klyvin">
          <img src="/brand/wordmark.png" alt="Klyvin" width="600" height="399" />
        </a>

        <nav class="footer-links" aria-label="روابط الفوتر">
          <a href="#features">المميزات</a>
          <a href="#products">أنواع المنتجات</a>
          <a href="#payments">الدفع والشحن</a>
          <a href="#reviews">آراء التجار</a>
        </nav>

        <ul class="social">
          <li>
            <a href="#start" aria-label="يوتيوب">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M21.6 7.2a2.8 2.8 0 0 0-2-2C17.9 4.8 12 4.8 12 4.8s-5.9 0-7.6.4a2.8 2.8 0 0 0-2 2A29 29 0 0 0 2 12a29 29 0 0 0 .4 4.8 2.8 2.8 0 0 0 2 2c1.7.4 7.6.4 7.6.4s5.9 0 7.6-.4a2.8 2.8 0 0 0 2-2A29 29 0 0 0 22 12a29 29 0 0 0-.4-4.8ZM10 15.5v-7l6 3.5-6 3.5Z" /></svg>
            </a>
          </li>
          <li>
            <a href="#start" aria-label="فيسبوك">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M14 9h3V6h-3c-2.2 0-4 1.8-4 4v2H8v3h2v7h3v-7h2.5l.5-3H13v-2c0-.6.4-1 1-1Z" /></svg>
            </a>
          </li>
          <li>
            <a href="#start" aria-label="إكس">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M17.5 3h3l-6.6 7.5L21.7 21h-6l-4.3-5.6L6.4 21H3.3l7-8L2.6 3h6.1l4 5.3L17.5 3Zm-1 16h1.6L7.1 4.6H5.4L16.5 19Z" /></svg>
            </a>
          </li>
          <li>
            <a href="#start" aria-label="إنستجرام">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5" /><circle cx="12" cy="12" r="4" /><circle cx="17.2" cy="6.8" r="1.2" fill="currentColor" stroke="none" /></svg>
            </a>
          </li>
        </ul>

        <p class="copyright">
          <span dir="ltr">© {year} Klyvin</span> — كل الحقوق محفوظة.
        </p>
      </div>
    </footer>
  </body>
</html>
