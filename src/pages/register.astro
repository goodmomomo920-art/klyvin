---
/**
 * Merchant sign-up.
 *
 * Creates the merchant account, its first store, the store settings row and a
 * default set of order statuses — all in one request, so a merchant never ends
 * up with a half-built store.
 */
import Layout from '../layouts/Layout.astro';
import { hashPassword } from '../lib/auth/password';
import { newId, newSessionToken, slugify } from '../lib/ids';
import { createMerchantSession, MERCHANT_COOKIE } from '../lib/auth/session';
import { str, isEmail, redirect } from '../lib/http';

if (Astro.locals.merchant) return redirect('/dashboard');

let error = Astro.url.searchParams.get('error') ?? '';

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const name = str(form.get('name'));
  const email = str(form.get('email')).toLowerCase();
  const password = str(form.get('password'));
  const storeName = str(form.get('storeName'));
  const db = Astro.locals.db;

  if (name.length < 2) error = 'اكتب اسمك من فضلك.';
  else if (!isEmail(email)) error = 'الإيميل مش صح.';
  else if (password.length < 8) error = 'الباسورد لازم 8 حروف على الأقل.';
  else if (storeName.length < 2) error = 'اكتب اسم المتجر.';

  if (!error) {
    const existing = await db
      .prepare('SELECT id FROM merchants WHERE email = ?1')
      .bind(email)
      .first<{ id: string }>();

    if (existing) {
      error = 'الإيميل ده مسجّل قبل كده. جرّب تدخل.';
    } else {
      const merchantId = newId('mrc');
      const storeId = newId('str');
      const passwordHash = await hashPassword(password);

      // Slug must be unique; fall back to a short suffix on collision.
      let slug = slugify(storeName) || 'store';
      const taken = await db
        .prepare('SELECT id FROM stores WHERE slug = ?1')
        .bind(slug)
        .first<{ id: string }>();
      if (taken) slug = `${slug}-${newId('', 4).slice(1)}`;

      await db
        .prepare(
          `INSERT INTO merchants (id, email, password_hash, name) VALUES (?1, ?2, ?3, ?4)`,
        )
        .bind(merchantId, email, passwordHash, name)
        .run();

      await db
        .prepare(`INSERT INTO stores (id, merchant_id, slug, name) VALUES (?1, ?2, ?3, ?4)`)
        .bind(storeId, merchantId, slug, storeName)
        .run();

      await db.prepare(`INSERT INTO store_settings (store_id) VALUES (?1)`).bind(storeId).run();

      // Default statuses so the first order has somewhere to land.
      const statuses: Array<[string, string, string, number]> = [
        ['جديد', 'new', 'open', 0],
        ['تم التأكيد', 'confirmed', 'paid', 1],
        ['تم الشحن', 'shipped', 'shipped', 2],
        ['تم التسليم', 'delivered', 'done', 3],
        ['ملغي', 'cancelled', 'cancelled', 4],
      ];
      for (const [label, statusSlug, kind, order] of statuses) {
        await db
          .prepare(
            `INSERT INTO order_statuses (id, store_id, name_ar, slug, kind, sort_order, is_default)
             VALUES (?1, ?2, ?3, ?4, ?5, ?6, ?7)`,
          )
          .bind(newId('ost'), storeId, label, statusSlug, kind, order, order === 0 ? 1 : 0)
          .run();
      }

      const token = newSessionToken();
      await createMerchantSession(db, merchantId, token);
      Astro.cookies.set(MERCHANT_COOKIE, token, {
        path: '/',
        httpOnly: true,
        sameSite: 'lax',
        maxAge: 60 * 60 * 24 * 30,
      });

      return redirect('/dashboard');
    }
  }
}

const errorMessage = error;
---

<Layout title="إنشاء حساب — Klyvin">
  <main class="auth">
    <div class="auth-card">
      <a href="/" class="auth-logo">
        <img src="/brand/wordmark.png" alt="Klyvin" width="132" height="88" />
      </a>

      <h1>أنشئ متجرك</h1>
      <p class="auth-sub">دقيقة واحدة وتكون جاهز.</p>

      {errorMessage && <p class="alert alert--error">{errorMessage}</p>}

      <form method="POST" class="auth-form">
        <label>
          اسمك
          <input name="name" type="text" required autocomplete="name" placeholder="محمد أحمد" />
        </label>

        <label>
          الإيميل
          <input name="email" type="email" required autocomplete="email" placeholder="you@example.com" dir="ltr" />
        </label>

        <label>
          الباسورد
          <input name="password" type="password" required minlength="8" autocomplete="new-password" placeholder="8 حروف على الأقل" dir="ltr" />
        </label>

        <label>
          اسم المتجر
          <input name="storeName" type="text" required placeholder="متجر النور" />
        </label>

        <button type="submit" class="btn btn--orange btn--block">إنشاء الحساب</button>
      </form>

      <p class="auth-foot">
        عندك حساب؟ <a href="/login">ادخل من هنا</a>
      </p>
    </div>
  </main>
</Layout>

<style>
  .auth {
    display: grid;
    place-items: center;
    min-height: 100vh;
    padding: 2rem 1.25rem;
    background: var(--paper);
  }

  .auth-card {
    width: min(440px, 100%);
    padding: 2rem;
    border: 1px solid var(--line);
    border-radius: 24px;
    background: #fff;
    box-shadow: 0 30px 60px -40px rgba(10, 10, 10, 0.4);
  }

  .auth-logo {
    display: inline-block;
    margin-block-end: 1rem;
  }

  .auth-logo img {
    width: 110px;
    height: auto;
  }

  h1 {
    font-family: var(--font-head);
    font-size: 1.5rem;
    font-weight: 800;
  }

  .auth-sub {
    margin-block: 0.3rem 1.4rem;
    color: var(--muted);
    font-size: 0.9rem;
  }

  .auth-form {
    display: grid;
    gap: 0.9rem;
  }

  .auth-form label {
    display: grid;
    gap: 0.35rem;
    font-size: 0.88rem;
    font-weight: 700;
  }

  .auth-form input {
    padding: 0.72rem 0.9rem;
    border: 1px solid var(--line);
    border-radius: 12px;
    font: inherit;
    font-size: 0.92rem;
  }

  .auth-form input:focus {
    outline: 2px solid var(--ember);
    outline-offset: 1px;
    border-color: transparent;
  }

  .auth-foot {
    margin-block-start: 1.2rem;
    color: var(--muted);
    font-size: 0.85rem;
    text-align: center;
  }

  .auth-foot a {
    color: var(--ember-deep);
    font-weight: 800;
  }

  .alert {
    margin-block-end: 1rem;
    padding: 0.7rem 0.9rem;
    border-radius: 12px;
    font-size: 0.85rem;
    font-weight: 700;
  }

  .alert--error {
    background: #fef2f2;
    color: #b91c1c;
  }
</style>
